# ---- Ring (pick one; with neither, Homebeat runs its labelled offline simulator) ----
# Ring Developer Playground token (30 min): https://developer.amazon.com/ring/console/playground
# You can also paste it in the app: Settings -> Ring connection.
RING_ACCESS_TOKEN=
# Linked Ring Appstore app (account linking): refresh token + app credentials
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
# HMAC signing key from app creation: verifies webhooks and account-linking nonces
RING_HMAC_KEY=
# Event History polling interval when there is no webhook (Playground / simulator)
RING_POLL_MS=4000

# ---- Vision + text model (Stage 3 of the CV funnel, rules, digests) ----
# bedrock | anthropic | openai (any OpenAI-compatible endpoint) | none
AI_PROVIDER=openai
AI_BASE_URL=http://127.0.0.1:8317/v1
AI_API_KEY=
AI_VISION_MODEL=claude-haiku-5-5
AI_TEXT_MODEL=claude-haiku-5-5
AI_REASONING_EFFORT=low
# Amazon Bedrock (AI_PROVIDER=bedrock): uses the standard AWS credential chain
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Anthropic API (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY_HOMEBEAT=

# ---- Household ----
HOUSEHOLD_TZ=America/Los_Angeles
SEED_SAMPLE=1

# ---- Optional ----
PORT=8787
PUBLIC_URL=http://localhost:8787
# Phone push through an ntfy.sh topic you own, e.g. https://ntfy.sh/homebeat-<random>
NTFY_URL=
# DEMO=1 enables POST /api/demo/reset; DEMO_FAST=1 shortens re-check timers to 1 minute
DEMO=
DEMO_FAST=
